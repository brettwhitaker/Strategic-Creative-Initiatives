    {
      "id": "6370f7a5-0918-56fb-a508-3343d9069c7c",
      "name": "Prepare messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        0
      ],
      "parameters": {
        "jsCode": "// One header message, then one card (with Research / Skip buttons) per new candidate.\nconst seg = $('Check the candidates').first().json.ctx.segment;\nconst rows = $input.all().map(i => i.json).filter(r => r.candidate_id);\nif (!rows.length) return [{ json: { kind: 'header',\n  text: '🧭 Weekly discovery (' + seg.category + ' in ' + seg.area + '): no new candidates this time. Next week tries a different category/area.' } }];\nreturn [{ json: { kind: 'header', text: rows[0].header } },\n        ...rows.map(r => ({ json: { kind: 'card', text: r.card, candidate_id: r.candidate_id } }))];"
      }
    },
