    {
      "id": "b81e8c7f-3765-5561-a57e-de52bb6412dc",
      "name": "Call Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        50
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "anthropic-beta",
              "value": "server-side-fallback-2026-07-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.state.request) }}",
        "options": {
          "timeout": 300000
        }
      },
      "credentials": {
        "anthropicApi": {
          "id": "",
          "name": "SCI – Claude (Sales)"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "id": "b4238d5e-d692-5efc-b0b2-323969cb7025",
      "name": "Collect results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        50
      ],
      "parameters": {
        "jsCode": "// Add up usage, remember which URLs were actually retrieved, and continue if Claude paused.\nconst st = JSON.parse(JSON.stringify($('Prepare Claude call').last().json.state));\nconst res = $json;\nconst u = res.usage || {};\nst.usage.input_tokens += u.input_tokens || 0;\nst.usage.output_tokens += u.output_tokens || 0;\nst.usage.cache_read_tokens += u.cache_read_input_tokens || 0;\nst.usage.cache_write_tokens += u.cache_creation_input_tokens || 0;\nst.usage.web_searches += (u.server_tool_use && u.server_tool_use.web_search_requests) || 0;\nconst walk = (v, inResult) => {\n  if (v == null) return;\n  if (typeof v === 'string') { if (inResult) for (const m of v.matchAll(/https?:\\/\\/[^\\s\"'<>)\\]]+/g)) st.retrieved.push(m[0]); return; }\n  if (Array.isArray(v)) { v.forEach(x => walk(x, inResult)); return; }\n  if (typeof v === 'object') {\n    const isRes = inResult || (typeof v.type === 'string' && v.type.endsWith('_tool_result'));\n    for (const val of Object.values(v)) walk(val, isRes);\n  }\n};\nwalk(res.content, false);\nst.iter += 1;\nst.stop_reason = res.stop_reason;\nif (res.stop_reason === 'pause_turn' && st.iter < 5) {\n  st.request.messages.push({ role: 'assistant', content: res.content });\n  return [{ json: { state: st, again: true } }];\n}\nst.final_content = res.content || [];\ndelete st.request;\nreturn [{ json: { state: st, again: false } }];"
      }
    },
    {
      "id": "bbf210f3-d962-5740-8917-57d6a7b35f3f",
      "name": "Claude paused? Continue",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2400,
        50
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
