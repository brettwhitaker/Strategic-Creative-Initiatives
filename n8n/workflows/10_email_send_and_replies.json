    {
      "id": "2064e0be-3d78-5dd6-96bf-a32cfae32133",
      "name": "Tidy messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        200
      ],
      "parameters": {
        "jsCode": "// Turn Gmail messages into the small shape the database expects.\nconst msgs = $input.all().map(i => i.json).map(m => ({\n  id: m.id,\n  thread_id: m.threadId || m.thread_id || '',\n  from: m.From || (m.from && (m.from.text || (m.from.value && m.from.value[0] && m.from.value[0].address))) || '',\n  subject: m.Subject || m.subject || '',\n  snippet: m.snippet || '',\n}));\nreturn [{ json: { messages: msgs } }];"
      }
    },
