    {
      "id": "2ac0186f-2e37-5db9-9601-abbda377851e",
      "name": "Check the posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        100
      ],
      "parameters": {
        "jsCode": "// Keep only posts whose URL Claude actually retrieved in this run (no invented posts).\nconst st = $json.state;\nconst norm = s => {\n  const m = /^https?:\\/\\/(?:www\\.|old\\.)?([^\\/?#\\s]+)([^?#\\s]*)/i.exec(String(s || '').trim());\n  return m ? (m[1] + m[2].replace(/\\/+$/, '')).toLowerCase() : null;\n};\nconst seen = new Set(st.retrieved.map(norm).filter(Boolean));\nconst call = st.final_content.find(b => b.type === 'tool_use' && b.name === 'submit_posts');\nif (!call) return [{ json: { ok: false, ctx: st.ctx, usage: st.usage,\n  error: 'Help Wanted scan finished without submitting posts (stop reason: ' + st.stop_reason + ')' } }];\nconst r = typeof call.input === 'string' ? JSON.parse(call.input) : call.input;\nconst all = r.posts || [];\nr.posts = all.filter(p => seen.has(norm(p.url))).slice(0, 6);\nreturn [{ json: { ok: true, result: r, dropped: all.length - r.posts.length, ctx: st.ctx, usage: st.usage } }];"
      }
    },
