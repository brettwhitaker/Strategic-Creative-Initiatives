    {
      "id": "6370f7a5-0918-56fb-a508-3343d9069c7c",
      "name": "Prepare messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        0
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.post_id);\nconst dropped = $('Check the posts').first().json.dropped || 0;\nconst tail = dropped ? ' (' + dropped + ' unconfirmed post(s) were dropped.)' : '';\nif (!rows.length) return [{ json: { kind: 'header', text: '🙋 Weekly Help Wanted scan: no new posts this week.' + tail } }];\nreturn [{ json: { kind: 'header', text: rows[0].header + tail } },\n        ...rows.map(r => ({ json: { kind: 'card', text: r.card, post_id: r.post_id } }))];"
      }
    },
