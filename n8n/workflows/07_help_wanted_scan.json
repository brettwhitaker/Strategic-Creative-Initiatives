    {
      "id": "c40e7655-5a9e-5157-8ac9-f43f1b20de94",
      "name": "Build Claude request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "const ctx = $json.ctx;\nconst k = ctx.knowledge || {};\nconst knowledge = ['positioning', 'services'].map(key => '## ' + key.toUpperCase() + '\\n' + String(k[key] || '').trim()).join('\\n\\n');\nconst request = {\n  model: ctx.model, max_tokens: 16000,\n  thinking: { type: 'adaptive' }, output_config: { effort: ctx.effort }, fallbacks: 'default',\n  system: [\n    { type: 'text', text: String(ctx.system_text).trim() },\n    { type: 'text', text: 'SCI BUSINESS KNOWLEDGE\\n\\n' + knowledge, cache_control: { type: 'ephemeral' } },\n  ],\n  tools: [\n    { type: 'web_search_20260209', name: 'web_search', max_uses: 6 },\n    { type: 'web_fetch_20260209', name: 'web_fetch', max_uses: 6, max_content_tokens: 6000 },\n    {\"name\": \"submit_posts\", \"description\": \"Submit the help-wanted posts you found. Call exactly once, at the end.\", \"strict\": true, \"input_schema\": {\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"posts\"], \"properties\": {\"posts\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"url\", \"platform\", \"community\", \"title\", \"posted\", \"location\", \"need_type\", \"summary\", \"quote\", \"fit_note\", \"suggested_reply\"], \"properties\": {\"url\": {\"type\": \"string\", \"description\": \"Exact URL of the post you retrieved\"}, \"platform\": {\"type\": \"string\", \"enum\": [\"reddit\", \"craigslist\", \"other\"]}, \"community\": {\"type\": \"string\", \"description\": \"e.g. 'Jacksonville Craigslist gigs' or the site/board name\"}, \"title\": {\"type\": \"string\"}, \"posted\": {\"type\": \"string\", \"description\": \"As shown on the post, or 'unknown'\"}, \"location\": {\"type\": \"string\"}, \"need_type\": {\"type\": \"string\", \"enum\": [\"website\", \"social_media\", \"content\", \"marketing\", \"other\"]}, \"summary\": {\"type\": \"string\"}, \"quote\": {\"type\": \"string\", \"description\": \"Short exact quote from the post\"}, \"fit_note\": {\"type\": \"string\"}, \"suggested_reply\": {\"type\": \"string\", \"description\": \"60-110 words, helpful first, for Brett to post himself\"}}}}}}},\n  ],\n  tool_choice: { type: 'auto' },\n  messages: [{ role: 'user', content:\n    'Today is ' + ctx.today + '. Find recent help-wanted posts and finish by calling submit_posts.\\n\\n' +\n    '<already_found>\\n' + (ctx.known_urls || []).join('\\n') + '\\n</already_found>' }],\n};\nreturn [{ json: { state: {\n  ctx: { run_id: ctx.run_id }, request, iter: 0, retrieved: [],\n  usage: { model: ctx.model, input_tokens: 0, output_tokens: 0, cache_read_tokens: 0, cache_write_tokens: 0, web_searches: 0 },\n} } }];"
      }
    },
    {
      "id": "b8941e29-0956-5e82-9d3e-1ab0ebd2a952",
      "name": "Prepare Claude call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all();"
      }
    },
    {
      "id": "b81e8c7f-3765-5561-a57e-de52bb6412dc",
      "name": "Call Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "anthropic-beta",
              "value": "server-side-fallback-2026-07-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.state.request) }}",
        "options": {
          "timeout": 300000
        }
      },
      "credentials": {
        "anthropicApi": {
          "id": "",
          "name": "SCI – Claude (Sales)"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "id": "b4238d5e-d692-5efc-b0b2-323969cb7025",
      "name": "Collect results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "jsCode": "// Add up usage, remember which URLs were actually retrieved, and continue if Claude paused.\nconst st = JSON.parse(JSON.stringify($('Prepare Claude call').last().json.state));\nconst res = $json;\nconst u = res.usage || {};\nst.usage.input_tokens += u.input_tokens || 0;\nst.usage.output_tokens += u.output_tokens || 0;\nst.usage.cache_read_tokens += u.cache_read_input_tokens || 0;\nst.usage.cache_write_tokens += u.cache_creation_input_tokens || 0;\nst.usage.web_searches += (u.server_tool_use && u.server_tool_use.web_search_requests) || 0;\nconst walk = (v, inResult) => {\n  if (v == null) return;\n  if (typeof v === 'string') { if (inResult) for (const m of v.matchAll(/https?:\\/\\/[^\\s\"'<>)\\]]+/g)) st.retrieved.push(m[0]); return; }\n  if (Array.isArray(v)) { v.forEach(x => walk(x, inResult)); return; }\n  if (typeof v === 'object') {\n    const isRes = inResult || (typeof v.type === 'string' && v.type.endsWith('_tool_result'));\n    for (const val of Object.values(v)) walk(val, isRes);\n  }\n};\nwalk(res.content, false);\nst.iter += 1;\nst.stop_reason = res.stop_reason;\nif (res.stop_reason === 'pause_turn' && st.iter < 5) {\n  st.request.messages.push({ role: 'assistant', content: res.content });\n  return [{ json: { state: st, again: true } }];\n}\nst.final_content = res.content || [];\ndelete st.request;\nreturn [{ json: { state: st, again: false } }];"
      }
    },
    {
      "id": "bbf210f3-d962-5740-8917-57d6a7b35f3f",
      "name": "Claude paused? Continue",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "Claude paused? Continue",
              "leftValue": "={{ $json.again }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
