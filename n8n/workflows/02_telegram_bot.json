  "nodes": [
    {
      "id": "b84f038b-0a2e-5dc3-b023-d53000a024ea",
      "name": "Telegram message or button",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "updates": [
          "message",
          "callback_query"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "SCI – Telegram Bot"
        }
      }
    },
    {
      "id": "9d47c7b4-f365-574d-b3a0-17a381b6a239",
      "name": "Read the command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "// Turn raw Telegram updates into simple commands. Anything else is dropped.\nconst out = [];\n$input.all().forEach((item, i) => {\n  const u = item.json;\n  const cb = u.callback_query;\n  const msg = u.message;\n  let kind = 'ignore', target = null, decision = null, arg = null;\n  if (cb) {\n    let m = /^ap:([0-9a-f-]{36}):(approved|rejected)$/.exec(cb.data || '');\n    if (m) { kind = 'decision'; target = m[1]; decision = m[2]; }\n    m = /^dc:([0-9a-f-]{36}):(research|skip)$/.exec(cb.data || '');\n    if (m) { kind = 'candidate'; target = m[1]; decision = m[2]; }\n    m = /^rd:([0-9a-f-]{36})$/.exec(cb.data || '');\n    if (m) { kind = 'redraft'; target = m[1]; }\n    m = /^hw:([0-9a-f-]{36}):(replied|skip)$/.exec(cb.data || '');\n    if (m) { kind = 'helpwanted'; target = m[1]; decision = m[2]; }\n  } else if (msg && typeof msg.text === 'string') {\n    const text = msg.text.trim();\n    const cmd = text.split(/\\s+/)[0].split('@')[0].toLowerCase();\n    if (['/pause', '/resume', '/status', '/help', '/start', '/prospect'].includes(cmd)) {\n      kind = cmd.slice(1);\n      arg = text.slice(text.split(/\\s+/)[0].length).trim().slice(0, 200);\n    }\n    // A reply to a draft card = notes for a rewrite.\n    const replied = msg.reply_to_message && msg.reply_to_message.text || '';\n    const ref = /Ref D-([0-9a-f]{8})/.exec(replied);\n    if (kind === 'ignore' && ref && !text.startsWith('/')) { kind = 'redraft_note'; decision = ref[1]; arg = text.slice(0, 1500); }\n  }\n  if (kind === 'ignore') return;\n  out.push({ json: {\n    kind, target, decision, arg,\n    fromId: String(cb ? cb.from.id : msg.from.id),\n    chatId: String(cb ? cb.message.chat.id : msg.chat.id),\n    callbackId: cb ? cb.id : '',\n    messageId: cb ? cb.message.message_id : null,\n    originalText: cb ? (cb.message.text || '') : '',\n  }, pairedItem: { item: i } });\n});\nreturn out;"
      }
    },
    {
      "id": "d8a408bf-e977-52e0-949c-aa93fa68bdf4",
      "name": "Ask the database (checks it's you)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select sci.handle_telegram($1, $2, nullif($3, '')::uuid, nullif($4, ''), nullif($5, '')) as reply",
        "options": {
          "queryReplacement": "={{ [ $json.kind, $json.fromId, $json.target || '', $json.decision || '', $json.arg || '' ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "",
          "name": "SCI DB – Approver"
        }
      }
    },
    {
