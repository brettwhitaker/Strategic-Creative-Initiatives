    {
      "id": "6370f7a5-0918-56fb-a508-3343d9069c7c",
      "name": "Prepare messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3120,
        0
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.approval_id);\nif (!rows.length) return [];\nconst out = [];\nif (rows[0].header) out.push({ json: { kind: 'header', text: rows[0].header } });\nrows.forEach(r => out.push({ json: { kind: 'card', text: r.card, approval_id: r.approval_id } }));\nreturn out;"
      }
